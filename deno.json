{
  "name": "@lonestone/chisel",
  "version": "0.3.0",
  "license": "MIT",
  "exports": "./src/main.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/path": "jsr:@std/path@^1.1.2"
  },
  "tasks": {
    "test": "deno test -A test/",
    "check": "deno check src/ test/ scripts/ && deno lint && deno fmt --check",
    "promote-intentions": "deno run --allow-read --allow-write --allow-run=git scripts/promote-intentions.ts",
    "release-check": "deno run --allow-read --allow-run=git scripts/release-check.ts",
    "commit-lint": "deno run --allow-read --allow-env=GITHUB_EVENT_PATH --allow-run=git scripts/commit-lint.ts",
    "hooks": "deno run --allow-read --allow-write --allow-run=git scripts/commit-lint.ts install-hook"
  },
  "publish": {
    "include": [
      "src/",
      "socle/",
      "deno.json",
      "README.md"
    ]
  },
  "fmt": {
    "include": [
      "src/",
      "test/",
      "scripts/"
    ],
    "exclude": [
      "test/fixtures/",
      "test/TESTS.md",
      "scripts/*.md"
    ]
  },
  "lint": {
    "include": [
      "src/",
      "test/",
      "scripts/"
    ],
    "exclude": [
      "test/fixtures/",
      "test/TESTS.md",
      "scripts/*.md"
    ]
  }
}
